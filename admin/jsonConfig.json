{
    "i18n": true,
    "type": "tabs",
    "items": {
        "tabDevices": {
            "type": "panel",
            "label": "Devices",
            "items": {
                "devicesHelp": {
                    "type": "staticText",
                    "text": "devicesHelp",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "devicesGuide": {
                    "type": "staticLink",
                    "href": "https://github.com/Schimi1983/ioBroker.androidtv#readme",
                    "button": true,
                    "variant": "outlined",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "text": "Open the step-by-step guide",
                    "icon": "book"
                },
                "_deviceManager": {
                    "type": "panel",
                    "label": "Device manager",
                    "items": {
                        "_dm": {
                            "type": "deviceManager",
                            "sm": 12,
                            "style": {
                                "width": "100%",
                                "height": "100%",
                                "overflow": "hidden"
                            }
                        }
                    },
                    "style": {
                        "width": "100%",
                        "height": "100%",
                        "overflow": "hidden"
                    },
                    "innerStyle": {
                        "width": "100%",
                        "height": "100%",
                        "overflow": "hidden"
                    }
                }
            }
        },
        "tabApps": {
            "type": "panel",
            "label": "App favorites",
            "items": {
                "appsHelp": {
                    "type": "staticText",
                    "text": "appsHelp",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "apps": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "uniqueColumns": [
                        "name"
                    ],
                    "items": [
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "30%",
                            "default": "",
                            "validator": "data.name && data.name.trim().length > 0",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "text",
                            "attr": "link",
                            "title": "Link or app ID",
                            "width": "70%",
                            "default": "",
                            "validator": "data.link && data.link.trim().length > 0",
                            "validatorNoSaveOnError": true
                        }
                    ]
                }
            }
        },
        "tabOptions": {
            "type": "panel",
            "label": "Options",
            "items": {
                "adbPollInterval": {
                    "type": "number",
                    "label": "Update playback info every",
                    "help": "adbPollHelp",
                    "min": 2,
                    "max": 300,
                    "unit": "s",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "clientName": {
                    "type": "text",
                    "label": "Client name",
                    "help": "clientNameHelp",
                    "expertMode": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "reconnectMax": {
                    "type": "number",
                    "label": "Maximum reconnect interval",
                    "help": "reconnectMaxHelp",
                    "min": 5,
                    "max": 3600,
                    "unit": "s",
                    "expertMode": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_headerSupport": {
                    "type": "header",
                    "size": 4,
                    "text": "header_support",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_textSupport": {
                    "type": "staticText",
                    "text": "support_text",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_linkSponsor": {
                    "type": "staticLink",
                    "text": "link_sponsor",
                    "href": "https://github.com/sponsors/Schimi1983",
                    "button": true,
                    "variant": "outlined",
                    "icon": "data:image/svg+xml;base64,",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "_linkPaypal": {
                    "type": "staticLink",
                    "text": "link_paypal",
                    "href": "https://paypal.me/Schimi1983",
                    "button": true,
                    "variant": "outlined",
                    "newLine": false,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "icon": "data:image/svg+xml;base64,"
                }
            }
        }
    }
}
