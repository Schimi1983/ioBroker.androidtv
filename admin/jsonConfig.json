{
    "i18n": true,
    "type": "tabs",
    "items": {
        "tabDevices": {
            "type": "panel",
            "label": "Devices",
            "items": {
                "devicesHelp": {
                    "type": "staticText",
                    "text": "devicesHelp",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "devicesGuide": {
                    "type": "staticLink",
                    "href": "https://github.com/Schimi1983/ioBroker.androidtv#readme",
                    "button": true,
                    "variant": "outlined",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "text": "Open the step-by-step guide",
                    "icon": "book"
                },
                "devices": {
                    "type": "accordion",
                    "titleAttr": "name",
                    "newLine": true,
                    "clone": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "name",
                            "label": "Name",
                            "default": "Android TV",
                            "validator": "data.name && data.name.trim().length > 0",
                            "validatorNoSaveOnError": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 6,
                            "lg": 4,
                            "xl": 4
                        },
                        {
                            "type": "text",
                            "attr": "host",
                            "label": "IP address",
                            "help": "ipHelp",
                            "default": "",
                            "validator": "data.host && data.host.trim().length > 0",
                            "validatorNoSaveOnError": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 6,
                            "lg": 4,
                            "xl": 4
                        },
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "label": "Enabled",
                            "default": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 6,
                            "lg": 4,
                            "xl": 4
                        },
                        {
                            "type": "select",
                            "attr": "connection",
                            "label": "Device type",
                            "default": "remote",
                            "newLine": true,
                            "options": [
                                {
                                    "label": "connRemote",
                                    "value": "remote"
                                },
                                {
                                    "label": "connRemoteAdb",
                                    "value": "remote_adb"
                                },
                                {
                                    "label": "connAdb",
                                    "value": "adb"
                                }
                            ],
                            "xs": 12,
                            "sm": 12,
                            "md": 6,
                            "lg": 6,
                            "xl": 6
                        },
                        {
                            "type": "checkbox",
                            "attr": "enableIme",
                            "label": "Current app & text input",
                            "tooltip": "enableImeTooltip",
                            "default": true,
                            "expertMode": true,
                            "hidden": "data.connection === 'adb'",
                            "xs": 12,
                            "sm": 6,
                            "md": 3,
                            "lg": 3,
                            "xl": 3
                        },
                        {
                            "type": "number",
                            "attr": "adbPort",
                            "label": "ADB port",
                            "default": 5555,
                            "min": 1,
                            "max": 65535,
                            "expertMode": true,
                            "hidden": "!(data.connection === 'adb' || data.connection === 'remote_adb')",
                            "xs": 12,
                            "sm": 6,
                            "md": 3,
                            "lg": 3,
                            "xl": 3
                        },
                        {
                            "type": "header",
                            "text": "Connect",
                            "size": 5,
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "staticText",
                            "text": "stepPair",
                            "hidden": "data.connection === 'adb'",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "sendTo",
                            "attr": "_startPairing",
                            "label": "Start pairing",
                            "command": "startPairing",
                            "jsonData": "{\"host\": \"${data.host}\"}",
                            "variant": "outlined",
                            "showProcess": true,
                            "timeout": 40000,
                            "disabled": "!data.host",
                            "hidden": "data.connection === 'adb'",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 4,
                            "lg": 3,
                            "xl": 3
                        },
                        {
                            "type": "text",
                            "attr": "_pin",
                            "label": "Code shown on the TV",
                            "maxLength": 6,
                            "disabled": "!data.host",
                            "hidden": "data.connection === 'adb'",
                            "xs": 12,
                            "sm": 6,
                            "md": 4,
                            "lg": 2,
                            "xl": 2
                        },
                        {
                            "type": "sendTo",
                            "attr": "_finishPairing",
                            "label": "Confirm code",
                            "command": "finishPairing",
                            "jsonData": "{\"host\": \"${data.host}\", \"pin\": \"${data._pin}\"}",
                            "variant": "contained",
                            "showProcess": true,
                            "timeout": 20000,
                            "disabled": "!data.host || !data._pin || data._pin.length !== 6",
                            "hidden": "data.connection === 'adb'",
                            "xs": 12,
                            "sm": 6,
                            "md": 4,
                            "lg": 3,
                            "xl": 3
                        },
                        {
                            "type": "staticText",
                            "text": "stepAdbRemote",
                            "hidden": "data.connection !== 'remote_adb'",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "staticText",
                            "text": "stepAdbFire",
                            "hidden": "data.connection !== 'adb'",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "staticText",
                            "text": "adbSecurity",
                            "hidden": "!(data.connection === 'adb' || data.connection === 'remote_adb')",
                            "newLine": true,
                            "style": {
                                "fontStyle": "italic",
                                "opacity": 0.8
                            },
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "header",
                            "text": "Status",
                            "size": 5,
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "textSendTo",
                            "attr": "_status",
                            "command": "deviceStatus",
                            "jsonData": "{\"host\": \"${data.host}\", \"enabled\": ${data.enabled !== false}}",
                            "alsoDependsOn": [
                                "host",
                                "enabled",
                                "connection"
                            ],
                            "container": "div",
                            "hidden": "!!data.host && data.enabled !== false && (originalData.devices || []).some(d => d && d.host === data.host && d.name === data.name && d.connection === data.connection && d.enabled !== false)",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "state",
                            "attr": "_liveStatus",
                            "oid": "${(data.name || data.host || '').trim().replace(/[äöüÄÖÜß]/g, c => ({ ä: 'ae', ö: 'oe', ü: 'ue', Ä: 'Ae', Ö: 'Oe', Ü: 'Ue', ß: 'ss' })[c]).replace(/[^A-Za-z0-9_-]+/g, '_').replace(/_+/g, '_').replace(/^_|_$/g, '')}.info.status",
                            "control": "text",
                            "readOnly": true,
                            "label": "",
                            "hidden": "!data.host || data.enabled === false || !(originalData.devices || []).some(d => d && d.host === data.host && d.name === data.name && d.connection === data.connection && d.enabled !== false)",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        }
                    ]
                }
            }
        },
        "tabApps": {
            "type": "panel",
            "label": "App favorites",
            "items": {
                "appsHelp": {
                    "type": "staticText",
                    "text": "appsHelp",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "apps": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "uniqueColumns": [
                        "name"
                    ],
                    "items": [
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "30%",
                            "default": "",
                            "validator": "data.name && data.name.trim().length > 0",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "text",
                            "attr": "link",
                            "title": "Link or app ID",
                            "width": "70%",
                            "default": "",
                            "validator": "data.link && data.link.trim().length > 0",
                            "validatorNoSaveOnError": true
                        }
                    ]
                }
            }
        },
        "tabOptions": {
            "type": "panel",
            "label": "Options",
            "items": {
                "adbPollInterval": {
                    "type": "number",
                    "label": "Update playback info every",
                    "help": "adbPollHelp",
                    "min": 2,
                    "max": 300,
                    "unit": "s",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "clientName": {
                    "type": "text",
                    "label": "Client name",
                    "help": "clientNameHelp",
                    "expertMode": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "reconnectMax": {
                    "type": "number",
                    "label": "Maximum reconnect interval",
                    "help": "reconnectMaxHelp",
                    "min": 5,
                    "max": 3600,
                    "unit": "s",
                    "expertMode": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_headerSupport": {
                    "type": "header",
                    "size": 4,
                    "text": "header_support",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_textSupport": {
                    "type": "staticText",
                    "text": "support_text",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_linkSponsor": {
                    "type": "staticLink",
                    "text": "link_sponsor",
                    "href": "https://github.com/sponsors/Schimi1983",
                    "button": true,
                    "variant": "outlined",
                    "icon": "data:image/svg+xml;base64,",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "_linkPaypal": {
                    "type": "staticLink",
                    "text": "link_paypal",
                    "href": "https://paypal.me/Schimi1983",
                    "button": true,
                    "variant": "outlined",
                    "newLine": false,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "icon": "data:image/svg+xml;base64,"
                }
            }
        }
    }
}
