{
    "i18n": true,
    "type": "tabs",
    "items": {
        "tabDevices": {
            "type": "panel",
            "label": "Devices",
            "items": {
                "devicesHelp": {
                    "type": "staticText",
                    "text": "devicesHelp",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "devices": {
                    "type": "accordion",
                    "titleAttr": "name",
                    "newLine": true,
                    "clone": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "name",
                            "label": "Name",
                            "default": "Android TV",
                            "validator": "data.name && data.name.trim().length > 0",
                            "validatorNoSaveOnError": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 6,
                            "lg": 3,
                            "xl": 3
                        },
                        {
                            "type": "text",
                            "attr": "host",
                            "label": "IP address / hostname",
                            "default": "",
                            "validator": "data.host && data.host.trim().length > 0",
                            "validatorNoSaveOnError": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 6,
                            "lg": 3,
                            "xl": 3
                        },
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "label": "Enabled",
                            "default": true,
                            "xs": 12,
                            "sm": 6,
                            "md": 6,
                            "lg": 2,
                            "xl": 2
                        },
                        {
                            "type": "checkbox",
                            "attr": "enableIme",
                            "label": "Current app & text input",
                            "tooltip": "enableImeTooltip",
                            "default": true,
                            "xs": 12,
                            "sm": 6,
                            "md": 6,
                            "lg": 4,
                            "xl": 4,
                            "hidden": "data.connection === 'adb'"
                        },
                        {
                            "type": "select",
                            "attr": "connection",
                            "label": "Connection",
                            "default": "remote",
                            "newLine": true,
                            "options": [
                                {
                                    "label": "connRemote",
                                    "value": "remote"
                                },
                                {
                                    "label": "connRemoteAdb",
                                    "value": "remote_adb"
                                },
                                {
                                    "label": "connAdb",
                                    "value": "adb"
                                }
                            ],
                            "xs": 12,
                            "sm": 12,
                            "md": 6,
                            "lg": 6,
                            "xl": 6
                        },
                        {
                            "type": "number",
                            "attr": "adbPort",
                            "label": "ADB port",
                            "default": 5555,
                            "min": 1,
                            "max": 65535,
                            "hidden": "data.connection !== 'adb' && data.connection !== 'remote_adb'",
                            "xs": 12,
                            "sm": 6,
                            "md": 3,
                            "lg": 2,
                            "xl": 2
                        },
                        {
                            "type": "staticText",
                            "text": "adbHint",
                            "newLine": true,
                            "hidden": "data.connection !== 'adb' && data.connection !== 'remote_adb'",
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "header",
                            "text": "Status",
                            "size": 5,
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "textSendTo",
                            "attr": "_status",
                            "command": "deviceStatus",
                            "jsonData": "{\"host\": \"${data.host}\", \"enabled\": ${data.enabled !== false}}",
                            "alsoDependsOn": [
                                "host",
                                "enabled",
                                "connection"
                            ],
                            "container": "div",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12
                        },
                        {
                            "type": "sendTo",
                            "attr": "_startPairing",
                            "label": "Start pairing",
                            "command": "startPairing",
                            "jsonData": "{\"host\": \"${data.host}\"}",
                            "variant": "outlined",
                            "showProcess": true,
                            "timeout": 40000,
                            "disabled": "!data.host",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 4,
                            "lg": 3,
                            "xl": 3,
                            "hidden": "data.connection === 'adb'"
                        },
                        {
                            "type": "text",
                            "attr": "_pin",
                            "label": "Code shown on the TV",
                            "maxLength": 6,
                            "disabled": "!data.host",
                            "xs": 12,
                            "sm": 6,
                            "md": 4,
                            "lg": 2,
                            "xl": 2,
                            "hidden": "data.connection === 'adb'"
                        },
                        {
                            "type": "sendTo",
                            "attr": "_finishPairing",
                            "label": "Confirm code",
                            "command": "finishPairing",
                            "jsonData": "{\"host\": \"${data.host}\", \"pin\": \"${data._pin}\"}",
                            "variant": "contained",
                            "showProcess": true,
                            "timeout": 20000,
                            "disabled": "!data.host || !data._pin || data._pin.length !== 6",
                            "xs": 12,
                            "sm": 6,
                            "md": 4,
                            "lg": 3,
                            "xl": 3,
                            "hidden": "data.connection === 'adb'"
                        },
                        {
                            "type": "staticText",
                            "text": "pairingHint",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 12,
                            "lg": 12,
                            "xl": 12,
                            "hidden": "data.connection === 'adb'"
                        }
                    ]
                }
            }
        },
        "tabApps": {
            "type": "panel",
            "label": "App favorites",
            "items": {
                "appsHelp": {
                    "type": "staticText",
                    "text": "appsHelp",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "apps": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "uniqueColumns": [
                        "name"
                    ],
                    "items": [
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "30%",
                            "default": "",
                            "validator": "data.name && data.name.trim().length > 0",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "text",
                            "attr": "link",
                            "title": "Deep link or package name",
                            "width": "70%",
                            "default": "",
                            "validator": "data.link && data.link.trim().length > 0",
                            "validatorNoSaveOnError": true
                        }
                    ]
                }
            }
        },
        "tabOptions": {
            "type": "panel",
            "label": "Options",
            "items": {
                "clientName": {
                    "type": "text",
                    "label": "Client name",
                    "help": "clientNameHelp",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "reconnectMax": {
                    "type": "number",
                    "label": "Maximum reconnect interval",
                    "help": "reconnectMaxHelp",
                    "min": 5,
                    "max": 3600,
                    "unit": "s",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "adbPollInterval": {
                    "type": "number",
                    "label": "Media poll interval (ADB)",
                    "help": "adbPollHelp",
                    "min": 2,
                    "max": 300,
                    "unit": "s",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        }
    }
}
